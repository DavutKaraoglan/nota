<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing may answer in the clear, including the stream helper. That helper is reached by bare
  IP and has no domain, so no public authority will issue for it; it carries a self-signed
  certificate and this app trusts that one certificate alone for that address. Narrower than
  the public roots: no other key, and no misissuing authority, can impersonate it.

  Replacing the certificate on the server means shipping a new APK with the new copy.

  This is the template build.sh copies into res/xml/ when the real file is absent. Put the
  address of your own helper in <domain> and its certificate in res/raw/notastream.pem;
  the pair identifies one deployment, so neither belongs in the repository.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!--
      Except to the app itself. The player reads remote songs through a proxy the app runs on
      the loopback address, which never leaves the device, and TLS there would mean trusting a
      certificate the app both issues and checks.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">example.invalid</domain>
        <trust-anchors>
            <certificates src="@raw/notastream" />
        </trust-anchors>
    </domain-config>
</network-security-config>
