<?xml version="1.0" encoding="utf-8"?>
<!-- Set in the weight the player uses for a song title, which is the one piece of type on the
     screen the listener already reads as a heading. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_mood"
    android:gravity="center"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:singleLine="true"
    android:textSize="14sp"
    android:textStyle="bold"
    android:textColor="@color/mood_text" />
