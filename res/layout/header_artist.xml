<?xml version="1.0" encoding="utf-8"?>
<!-- The artist's own header: no thumbnail, since the banner behind it is their picture. The
     space above the name is what lets that banner be seen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/gutter"
    android:paddingEnd="@dimen/gutter"
    android:paddingTop="150dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/listened"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:maxLines="1"
        android:textSize="13sp"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <HorizontalScrollView
        android:id="@+id/links_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/links"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/bio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:maxLines="4"
        android:ellipsize="end"
        android:lineSpacingExtra="1dp"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

    <!-- The ellipsis the folded life ends on, made a thing that can be pressed. -->
    <TextView
        android:id="@+id/bio_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:paddingEnd="12dp"
        android:text="…"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@color/accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_play"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:scaleType="centerInside"
            android:background="@drawable/bg_button"
            android:src="@drawable/ic_play"
            android:tint="@color/accent"
            android:contentDescription="@string/play_all" />

        <ImageButton
            android:id="@+id/btn_shuffle"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:scaleType="centerInside"
            android:background="@drawable/bg_button"
            android:src="@drawable/ic_shuffle"
            android:tint="@color/accent"
            android:contentDescription="@string/shuffle" />

        <Button
            android:id="@+id/btn_follow"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/accent"
            android:textAllCaps="false"
            android:background="@drawable/bg_button"
            android:text="@string/follow" />
    </LinearLayout>
</LinearLayout>
