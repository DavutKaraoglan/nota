<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="6dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/chip_songs" style="@style/Chip" />
            <TextView android:id="@+id/chip_albums" style="@style/Chip" />
            <TextView android:id="@+id/chip_artists" style="@style/Chip" />
            <TextView android:id="@+id/chip_folders" style="@style/Chip" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/lib_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
